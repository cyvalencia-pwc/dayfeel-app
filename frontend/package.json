{
  "name": "@dayfeel/frontend",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "types:generate": "openapi-typescript ../docs/openapi/identity-service.json -o src/types/identity.generated.ts && openapi-typescript ../docs/openapi/content-service.json -o src/types/content.generated.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "axios": "^1.12.0",
    "@tanstack/react-query": "^5.90.0",
    "zustand": "^5.0.8",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "@vitejs/plugin-react": "^4.7.0",
    "tailwindcss": "^4.1.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/node": "^22.0.0",
    "vitest": "^3.2.7",
    "jsdom": "^26.1.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@testing-library/jest-dom": "^6.9.0",
    "@playwright/test": "^1.55.0",
    "openapi-typescript": "^7.9.1"
  }
}
