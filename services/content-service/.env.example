PORT=8082
MONGODB_URI=mongodb://localhost:27018/dayfeel_content?replicaSet=rs0&directConnection=true
IDENTITY_URL=http://localhost:8081
AI_URL=http://localhost:8000
INTERNAL_KEY=replace-with-at-least-32-characters
JWKS_URL=http://localhost:8081/.well-known/jwks.json
JWT_ISSUER=dayfeel-identity
JWT_AUDIENCE=dayfeel
KAFKA_BROKERS=localhost:9092
LOG_LEVEL=info
