DB_URL=jdbc:mysql://localhost:3306/dayfeel_identity
DB_USER=dayfeel
DB_PASSWORD=dayfeel-local-only
INTERNAL_KEY=replace-with-a-long-random-secret
JWT_EPHEMERAL_KEYS=true
# Production: false, and mount PKCS8 private / X509 public PEM files.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
STORAGE_MODE=local
EVENTS_MODE=log
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=us-east-1

# Set EVENTS_MODE=kafka to deliver events. Host applications use this address.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
