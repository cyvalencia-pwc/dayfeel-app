      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT RS256"
      },
      "internalKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Internal-Key"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "timestamp",
          "status",
          "code",
          "message",
          "path",
          "traceId"
        ],
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "traceId": {
            "type": "string"
          }
        }
      },
      "Credentials": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "password": {
            "type": "string",
            "minLength": 12,
            "maxLength": 72,
            "writeOnly": true,
            "description": "Registration also enforces 72 UTF-8 bytes maximum."
          }
        }
      },
      "Refresh": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "refreshToken"
        ],
        "properties": {
          "refreshToken": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "writeOnly": true
          }
        }
      },
      "Tokens": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "accessToken",
          "refreshToken",
          "tokenType",
          "expiresIn"
        ],
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "refreshToken": {
            "type": "string"
          },
          "tokenType": {
            "type": "string",
            "enum": [
              "Bearer"
            ]
          },
          "expiresIn": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "Consent": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "companionMemory": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "Profile": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "alias",
          "avatarUrl",
          "consent"
        ],
        "properties": {
          "alias": {
            "type": "string"
          },
          "avatarUrl": {
            "type": "string",
            "nullable": true
          },
          "consent": {
            "$ref": "#/components/schemas/Consent"
          }
        }
      },
      "Alias": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "alias"
        ],
        "properties": {
          "alias": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9]{2,39}$"
          }
        }
      },
      "AvatarRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "contentType",
          "size"
        ],
        "properties": {
          "contentType": {
            "type": "string",
            "enum": [
              "image/jpeg",
              "image/png",
              "image/webp"
            ]
          },
          "size": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "maximum": 5242880
          }
        }
      },
      "Upload": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "objectKey",
          "url",
          "expiresAt",
          "uploadSupported",
          "requiredHeaders"
        ],
        "properties": {
          "objectKey": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "description": "Empty for local stub"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "uploadSupported": {
            "type": "boolean"
          },
          "requiredHeaders": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      },
      "Circle": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "joined"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "joined": {
            "type": "boolean",
            "description": "Whether the authenticated user has an active membership in this circle. Membership does not override moderation restrictions."
          }
        }
      },
      "CreateCircle": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        }
      },
      "Membership": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "active",
          "role",
          "mutedUntil",
          "bannedUntil"
        ],
        "properties": {
          "active": {
            "type": "boolean"
          },
          "role": {
            "type": "string",
            "enum": [
              "OWNER",
              "MODERATOR",
              "MEMBER"
            ]
          },
          "mutedUntil": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "bannedUntil": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      },
      "Restriction": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "member",
          "muted",
          "banned"
        ],
        "properties": {
          "member": {
            "type": "boolean"
          },
          "muted": {
            "type": "boolean"
          },
          "banned": {
            "type": "boolean"
          }
        }
      },
      "AiReport": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "targetId",
          "circleId",
          "contentId",
          "reason",
          "source"
        ],
        "properties": {
          "targetId": {
            "type": "string",
            "format": "uuid"
          },
          "circleId": {
            "type": "string",
            "format": "uuid"
          },
          "contentId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "reason": {
            "type": "string",
            "enum": [
              "HARASSMENT",
              "SPAM",
              "UNSAFE",
              "OTHER"
            ]
          },
          "source": {
            "type": "string",
            "enum": [
              "AI"
            ]
          }
        }
      },
      "ReportInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "targetId",
          "circleId",
          "reason"
        ],
        "properties": {
          "targetId": {
            "type": "string",
            "format": "uuid"
          },
          "circleId": {
            "type": "string",
            "format": "uuid"
          },
          "contentId": {
            "type": "string",
            "maxLength": 100,
            "nullable": true
          },
          "reason": {
            "type": "string",
            "enum": [
              "HARASSMENT",
              "SPAM",
              "UNSAFE",
              "OTHER"
            ]
          }
        }
      },
      "Id": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "Moderation": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "targetId",
          "action"
        ],
        "properties": {
          "targetId": {
            "type": "string",
            "format": "uuid"
          },
          "action": {
            "type": "string",
            "enum": [
              "MUTE",
              "BAN",
              "UNBAN",
              "REMOVE_CONTENT"
            ]
          },
          "until": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "Required for MUTE/BAN; future and at most 365 days."
          },
          "contentId": {
            "type": "string",
            "maxLength": 100,
            "nullable": true,
            "description": "Required for REMOVE_CONTENT."
          }
        }
      },
      "PrivacyRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "status",
          "downloadUrl"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "type": "string",
            "enum": [
              "EXPORT",
              "DELETION"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "COMPLETED"
            ]
          },
          "downloadUrl": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "Aliases": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "userIds"
        ],
        "properties": {
          "userIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "minItems": 1,
            "maxItems": 100
          }
        }
      },
      "AliasMap": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        },
        "description": "Internal mapping only. Never expose user IDs to community clients."
      },
      "Completion": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requestId",
          "userId"
        ],
        "properties": {
          "requestId": {
            "type": "string",
            "format": "uuid"
          },
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "objectKey": {
            "type": "string",
            "maxLength": 512,
            "nullable": true,
            "description": "Required for export: exports/{requestId}/{name}.zip"
          }
        }
      },
      "IdentityExport": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "email",
          "alias",
          "createdAt",
          "consent",
          "avatarKey",
          "roles",
          "ownedCircles",
          "memberships",
          "reports",
          "moderationActions",
          "privacyRequests"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "alias": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "consent": {
            "$ref": "#/components/schemas/Consent"
          },
          "avatarKey": {
            "type": "string",
            "nullable": true
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "ownedCircles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Circle"
            }
          },
          "memberships": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ExportMembership"
            }
          },
          "reports": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ExportReport"
            }
          },
          "moderationActions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ExportAction"
            }
          },
          "privacyRequests": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ExportRequest"
            }
          }
        }
      },
      "Jwks": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "keys"
        ],
        "properties": {
          "keys": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kty",
                "use",
                "alg",
                "kid",
                "n",
                "e"
              ],
              "properties": {
                "kty": {
                  "type": "string",
                  "enum": [
                    "RSA"
                  ]
                },
                "use": {
                  "type": "string",
                  "enum": [
                    "sig"
                  ]
                },
                "alg": {
                  "type": "string",
                  "enum": [
                    "RS256"
                  ]
                },
                "kid": {
                  "type": "string"
                },
                "n": {
                  "type": "string"
                },
                "e": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "Health": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string"
          }
        }
      },
      "Event": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "version",
          "occurredAt",
          "payload"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
            "type": "string",
            "enum": [
              "ConsentChanged",
              "ModerationActionCreated",
              "DataExportRequested",
              "UserDeletionRequested",
              "DataExportCompleted",
              "UserDeletionCompleted"
            ]
          },
          "version": {
            "type": "integer",
            "enum": [
              1
            ]
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "payload": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "ExportMembership": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "circleId",
          "role",
          "active",
          "mutedUntil",
          "bannedUntil"
        ],
        "properties": {
          "circleId": {
            "type": "string",
            "format": "uuid"
          },
          "role": {
            "type": "string",
            "enum": [
              "OWNER",
              "MODERATOR",
              "MEMBER"
            ]
          },
          "active": {
            "type": "boolean"
          },
          "mutedUntil": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "bannedUntil": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      },
      "ExportReport": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "circleId",
          "contentId",
          "reason",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "circleId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "contentId": {
            "type": "string",
            "nullable": true
          },
          "reason": {
            "type": "string",
            "enum": [
              "HARASSMENT",
              "SPAM",
              "UNSAFE",
              "OTHER"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ExportAction": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "circleId",
          "contentId",
          "action",
          "createdAt",
          "performedByUser"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "circleId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "contentId": {
            "type": "string",
            "nullable": true
          },
          "action": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "performedByUser": {
            "type": "boolean"
          }
        }
      },
      "ExportRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "status",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "type": "string",
            "enum": [
              "EXPORT",
              "DELETION"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "COMPLETED"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Session": {
        "type": "object",
        "required": [
          "roles",
          "onboardingComplete"
        ],
        "properties": {
          "roles": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "USER",
                "MODERATOR",
                "ADMIN"
              ]
            }
          },
          "onboardingComplete": {
            "type": "boolean"
          }
        }
      },
      "Onboarding": {
        "type": "object",
        "required": [
          "acknowledged"
        ],
        "properties": {
          "acknowledged": {
            "type": "boolean",
            "enum": [
              true
            ]
          }
        }
      },
      "ReportView": {
        "type": "object",
        "required": [
          "id",
          "targetId",
          "circleId",
          "contentId",
          "reason",
          "source",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "targetId": {
            "type": "string",
            "format": "uuid"
          },
          "circleId": {
            "type": "string",
            "format": "uuid"
          },
          "contentId": {
            "type": "string",
            "nullable": true
          },
          "reason": {
            "type": "string",
            "enum": [
              "HARASSMENT",
              "SPAM",
              "UNSAFE",
              "OTHER"
            ]
          },
          "source": {
            "type": "string",
            "enum": [
              "AI",
              "USER"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "responses": {
      "StandardError": {
        "description": "Sanitized error with traceId; unexpected errors never include exception messages.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    }
  }
}
